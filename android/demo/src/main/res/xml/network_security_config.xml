<?xml version="1.0" encoding="utf-8"?>
<!-- The embedded node serves web apps and its client API over plain HTTP and
     WebSocket on 127.0.0.1. Bundled test pages load from appkit.bundle, which
     the WebView intercepts and never sends to the network. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">appkit.bundle</domain>
    </domain-config>
</network-security-config>
