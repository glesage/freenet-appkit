<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 9 have no DayNight device theme, so they get the light one.
     values-v29/themes.xml follows the system's dark mode from Android 10. -->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:colorAccent">@color/brand</item>
    </style>
</resources>
